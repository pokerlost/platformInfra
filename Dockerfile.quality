# syntax=docker/dockerfile:1.27.1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM ghcr.io/astral-sh/uv:0.12.15@sha256:62f8c047d0a0e9ece6b53fc63df902585a67a47a7f318ddec4a37db586edc8e3 AS uv
FROM python:3.15.2-slim-bookworm@sha256:96599df822d0e1c6bb700014a05c7f3c8cabc6e0f7ff3c4f9f69cee033b4b5d9 AS quality-dependencies
COPY --from=uv /uv /usr/local/bin/uv
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends make git curl jq build-essential cmake ninja-build ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://get.helm.sh/helm-v4.3.1-linux-amd64.tar.gz -o /tmp/helm.tgz \
    && echo '0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b  /tmp/helm.tgz' | sha256sum -c - \
    && tar -xzf /tmp/helm.tgz -C /tmp linux-amd64/helm \
    && install /tmp/linux-amd64/helm /usr/local/bin/helm && rm -rf /tmp/helm.tgz /tmp/linux-amd64
RUN curl --fail --silent --show-error --location https://dl.k8s.io/release/v1.37.0/bin/linux/amd64/kubectl --output /usr/local/bin/kubectl \
    && echo '6129359f4e1f3848a5572ccb0b26cf28b8ca08cef38c95a765b2f64a2c961a2f  /usr/local/bin/kubectl' | sha256sum --check --status \
    && chmod 755 /usr/local/bin/kubectl
WORKDIR /app
ENV PATH=/app/.venv/bin:$PATH UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PYTHONDONTWRITEBYTECODE=1 CONTAINERIZED=1
COPY pyproject.toml uv.lock README.md .gitignore ./
RUN --mount=type=cache,id=python-quality-uv-314-linux-amd64,target=/root/.cache/uv,sharing=locked uv sync --locked --all-groups --no-install-project
FROM quality-dependencies AS quality
COPY --chmod=u=rwX,go=rX . ./
RUN --mount=type=cache,id=python-quality-uv-314-linux-amd64,target=/root/.cache/uv,sharing=locked uv sync --locked --all-groups
CMD ["make", "check"]
