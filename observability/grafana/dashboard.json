{
  "uid": "pokerlost-local",
  "title": "Pokerlost local observability",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "pokerlost",
    "local"
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "local",
        "hide": 2,
        "current": {
          "text": "local",
          "value": "local"
        }
      },
      {
        "name": "service",
        "type": "custom",
        "query": "authService,accountsService,virtualMoney,pokerService,cryptoService,pokerGateway,pokerWeb",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "request_id",
        "type": "textbox",
        "label": "Request ID",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service_id) (rate(http_requests_total{environment=\"$environment\",service_id=~\"${service:regex}\"}[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum by (service_id) (rate(http_requests_total{environment=\"$environment\",service_id=~\"${service:regex}\",status=~\"5..\"}[5m])) or on (service_id) (sum by (service_id) (rate(http_requests_total{environment=\"$environment\",service_id=~\"${service:regex}\"}[5m])) * 0)) / clamp_min(sum by (service_id) (rate(http_requests_total{environment=\"$environment\",service_id=~\"${service:regex}\"}[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Latency p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service_id) (rate(http_request_duration_seconds_bucket{environment=\"$environment\",service_id=~\"${service:regex}\"}[5m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Requests in flight",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "http_requests_inprogress{environment=\"$environment\",service_id=~\"${service:regex}\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "title": "Process CPU cores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{environment=\"$environment\",service_id=~\"${service:regex}\"}[5m])",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "title": "Process resident bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{environment=\"$environment\",service_id=~\"${service:regex}\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 7,
      "title": "Scrape / collector health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{environment=\"$environment\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 8,
      "title": "Gateway request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(traefik_service_requests_total{environment=\"$environment\"}[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "id": 9,
      "title": "Correlated logs (request_id is metadata, not a stream label)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{environment=\"$environment\", service_id=~\"${service:regex}\"} | request_id=~\"$request_id\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 10,
      "title": "Liveness / dependency readiness (1 = HTTP 2xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{environment=\"$environment\",service_id=~\"${service:regex}\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 44
      }
    }
  ]
}
