# Select explicitly: uv run -m tools.environment --env-file /path/to/local.env
# CLI options > PLATFORM_* environment > selected file > defaults.
PLATFORM_ENVIRONMENT=local
PLATFORM_MODE=local
# Source checkouts are siblings; local build uses actual sourceCommit pins.
PLATFORM_SOURCE_ROOT=..
# Replace both with private absolute paths OUTSIDE every source checkout.
PLATFORM_STATE_DIR=/replace_with_private_state_directory
PLATFORM_SECRET_DIR=/replace_with_private_secrets_directory
PLATFORM_HTTP_PORT=18080
PLATFORM_HTTPS_PORT=18443
PLATFORM_PROMETHEUS_PORT=19090
PLATFORM_GRAFANA_PORT=13000
PLATFORM_LOKI_PORT=13100
PLATFORM_ALLOY_PORT=12345
PLATFORM_SYSLOG_PORT=15140
# Remote mode is prepared config only; target/auth/TLS approval is separate.
